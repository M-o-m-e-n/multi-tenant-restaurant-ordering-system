# Copy to server/.env and adjust. Never commit the real file (NFR-S10).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml
DATABASE_URL=postgresql://ros:ros@localhost:5432/ros?schema=public
# Used by integration tests (created by docker/postgres/init)
TEST_DATABASE_URL=postgresql://ros:ros@localhost:5432/ros_test?schema=public

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# E2E only: switch the rate limits off (refused when NODE_ENV=production).
RATE_LIMITS_DISABLED=false

BCRYPT_ROUNDS=12

# Stripe TEST keys (optional). Without them, card payment is off and staff take cash.
# Live keys are refused at boot. For local webhooks run: stripe listen --forward-to localhost:4000/api/v1/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the web app is served; printed QR codes point at <this>/t/<token>.
PUBLIC_APP_URL=http://localhost:5173

# Comma-separated allow-list; no wildcard.
CLIENT_ORIGINS=http://localhost:5173
